LAMMPS (21 Nov 2023 - Development - e94d89ee3c-modified)
# Initialize simulation

variable nsteps index 100000
variable nevery equal 1 # frequency (in number of steps) in which qeq is run to optimize charges
variable temp equal 4000.0 # starting temperature (should equilibrate to ~ 1/2 this value)
variable coulcut equal 10 # global coulomb cutoff (see pair_style), used in QEq fix
variable nrep equal 16 # cell multiple
variable a equal 3.16 # bcc lattice vector (a) for tungsten
variable streitzalpha equal 0.2
units metal
atom_style charge

boundary p p p

lattice bcc ${a} # bcc
lattice bcc 3.16 
Lattice spacing in x,y,z = 3.16 3.16 3.16
variable nx equal ${nrep}
variable nx equal 16
variable ny equal ${nrep}
variable ny equal 16
variable nz equal ${nrep}
variable nz equal 16
lattice         bcc ${a}
lattice         bcc 3.16
Lattice spacing in x,y,z = 3.16 3.16 3.16
region          box block 0 ${nx} 0 ${ny} 0 ${nz}
region          box block 0 16 0 ${ny} 0 ${nz}
region          box block 0 16 0 16 0 ${nz}
region          box block 0 16 0 16 0 16

create_box      2 box
Created orthogonal box = (0 0 0) to (50.56 50.56 50.56)
  2 by 1 by 5 MPI processor grid
create_atoms    2 box
Created 8192 atoms
  using lattice units in orthogonal box = (0 0 0) to (50.56 50.56 50.56)
  create_atoms CPU = 0.000 seconds

# Add this section to create 10 random nitrogen atoms (type 2)
region nitrogen_region block 0 ${nx} 0 ${ny} 0 ${nz} units lattice
region nitrogen_region block 0 16 0 ${ny} 0 ${nz} units lattice
region nitrogen_region block 0 16 0 16 0 ${nz} units lattice
region nitrogen_region block 0 16 0 16 0 16 units lattice
create_atoms 1 random 10 12345 nitrogen_region
Created 10 atoms
  using lattice units in orthogonal box = (0 0 0) to (50.56 50.56 50.56)
  create_atoms CPU = 0.000 seconds
mass 1 14.0067 # Mass for nitrogen
mass 2 183.84 # Mass for tungsten

set group all charge 1.e-100
Setting atom values ...
  8202 settings made for charge
include WN_pot.mod
# This file was generated by FitSNAP.
# Hash: ae73c556e21728af5558c083907c4ae6

pair_style hybrid/overlay coul/streitz 10.0 ewald pace product
ACE version: 2023.11.25
Product evaluator is used
pair_coeff * * coul/streitz NW_auto.0000.streitz N W
pair_coeff * * pace WN_pot.yace N W
Loading WN_pot.yace
Total number of basis functions
	N: 16 (r=1) 90 (r>1)
	W: 16 (r=1) 90 (r>1)
Mapping LAMMPS atom type #1(N) -> ACE species type #0
Mapping LAMMPS atom type #2(W) -> ACE species type #1
kspace_style ewald 1.0e-6
#pair_style hybrid/overlay pace product
#pair_coeff * * pace WN_pot.yace N W

#Replicate
#replicate 3 3 3
# Define computes and variables to view from simulation
compute eatom all pe/atom
compute energy all reduce sum c_eatom
compute satom all stress/atom NULL
compute str all reduce sum c_satom[1] c_satom[2] c_satom[3]
variable press equal (c_str[1]+c_str[2]+c_str[3])/(3*vol)


# Tell 'thermo' what values should be printed
thermo_style custom step temp epair c_energy etotal press v_press
thermo 100
thermo_modify norm yes
# Prepare for NVE MD run
timestep 0.5e-3
neighbor 1.0 bin
neigh_modify once no every 1 delay 0 check yes

fix 1q all qeq/slater ${nevery} ${coulcut} 1.0e-6 100 coul/streitz alpha ${streitzalpha}
fix 1q all qeq/slater 1 ${coulcut} 1.0e-6 100 coul/streitz alpha ${streitzalpha}
fix 1q all qeq/slater 1 10 1.0e-6 100 coul/streitz alpha ${streitzalpha}
fix 1q all qeq/slater 1 10 1.0e-6 100 coul/streitz alpha 0.2

dump 2min all cfg 1 min.*.cfg mass type xs ys zs
run             0
